<?xml version="1.0"?>
<robot name="quadcopter">
  <material name="body"><color rgba="0.16 0.17 0.2 1"/></material>
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.012" iyy="0.012" izz="0.022" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0"/>
      <geometry><mesh filename="quadcopter.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="body"/>
    </visual>
    <collision>
      <origin xyz="0 0 0"/>
      <geometry><cylinder radius="0.320" length="0.10"/></geometry>
    </collision>
  </link>
</robot>
